{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-node.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-component-path.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-node.sh\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-duplicate-types.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
