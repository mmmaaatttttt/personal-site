{
  "name": "mattlane.us",
  "description": "Matt Lane personal site",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git://github.com/mmmaaatttttt/personal-site.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/optimize-images.js && next build && node scripts/fix-canonical-urls.js",
    "deploy:worker": "wrangler deploy --config workers/subscribe/wrangler.toml",
    "dev": "node scripts/optimize-images.js && next dev",
    "dev:email": "email dev --dir emails",
    "lint": "biome check",
    "lint:write": "biome check --write --unsafe",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@next/mdx": "^16.2.10",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/katex": "^0.16.8",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "d3-force-bounce": "^1.0.2",
    "d3-force-surface": "^1.0.2",
    "framer-motion": "^12.42.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.11",
    "odex": "^3.0.0-rc.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-email": "^6.6.4",
    "react-select": "^5.10.2",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^7.0.9",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.61.1",
    "@react-email/ui": "^6.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  }
}
